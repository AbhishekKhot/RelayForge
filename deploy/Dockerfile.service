FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY . .
RUN mvn -B -q package -DskipTests
RUN mkdir -p /workspace/health && javac -d /workspace/health deploy/HealthProbe.java

FROM eclipse-temurin:21-jre
ARG MODULE
WORKDIR /app
COPY --from=build /workspace/${MODULE}/target/${MODULE}-0.1.0-SNAPSHOT.jar /app/service.jar
COPY --from=build /workspace/health/HealthProbe.class /app/HealthProbe.class
USER 10001:10001
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/service.jar"]
